#SMTP settings
smtp_email="no-reply@krusplan.se"
smtp_password="Password123"
smtp_server_address=smtp.server.com
smtp_port=587
# Betrodd adress för verifieringslänkar. Tomt: kursplan.se i drift,
# http://127.0.0.1:<app_port> i DEV_MODE. Ange extern HTTPS-adress vid proxy.
PUBLIC_BASE_URL=
# 0 stänger av alla utskick; nya konton behöver fortfarande verifieras.
send_mail=1





# Test account
test_email="test@krusplan.se"
test_password="Password123"

# Vanligt konto i DEV_MODE. Tomma värden ger genererade lokala uppgifter.
dev_user_email=
dev_user_password=





#Database settings
# PostgreSQL-anslutning; provas även i DEV_MODE före temporär SQLite.
db_path=


#flask settings
# Inloggningar gäller i 60 dagar från senaste besöket (ställs in i app.py).
app_secret_key="supersecretkey"
app_port=80
app_host="0.0.0.0"
DEV_MODE=false
# Loggning: DEBUG styr endast loggnivån och aktiverar inte Flasks felsökare.
DEBUG=false
# Lokal loggmapp, relativ projektroten eller en absolut sökväg.
# Docker Compose använder alltid /app/logs i den beständiga volymen app_logs.
LOG_DIR=logs
# Rotera vid 10 MiB och behåll fem tidigare filer utöver kursplan.log.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Activates the matching Compose profile; keep this linked to DEV_MODE.
COMPOSE_PROFILES=${DEV_MODE:-false}
